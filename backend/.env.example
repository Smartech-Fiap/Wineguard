# Copie para .env apenas no ambiente local. Nunca use credenciais reais neste arquivo versionado.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wineguard
SPRING_DATASOURCE_USERNAME=wineguard
SPRING_DATASOURCE_PASSWORD=wineguard-local
SERVER_PORT=8080
FIWARE_ORION_BASE_URL=http://localhost:1026
FIWARE_IOTA_BASE_URL=http://localhost:4041
FIWARE_IOTA_API_KEY=
FIWARE_SERVICE=vinheria
FIWARE_SERVICE_PATH=/
FIWARE_STH_BASE_URL=http://localhost:8666
# Habilite somente após preparar o firmware, o IoT Agent e a ACL MQTT.
FIWARE_CONFIGURATION_ENABLED=false
