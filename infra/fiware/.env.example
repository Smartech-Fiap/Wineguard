# Modelo para NOVA instalacao. Nao aplicar sobre os volumes da VM existente.
# Compose le este arquivo; os scripts Python usam as variaveis exportadas.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=

# Local: loopback. Na EC2 FIWARE: use o IP PRIVADO da instancia e restrinja o SG.
FIWARE_BIND_ADDRESS=127.0.0.1
MQTT_TLS_BIND_ADDRESS=0.0.0.0

FIWARE_SERVICE=vinheria
FIWARE_SERVICE_PATH=/
IOTA_API_KEY=
DEVICE_ID=wine002
ENTITY_ID=WineSensor002
ENTITY_TYPE=WineSensor
MQTT_USERNAME=wineguard_esp32

# IP publico fixo ou DNS usado pelo ESP. Deve constar no SAN do certificado.
MQTT_TLS_HOST=
